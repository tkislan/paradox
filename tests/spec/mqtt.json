{
  "_comment": "MQTT link behavior as data. 'credentials': what the broker receives in CONNECT (or how connecting fails) for MQTT_USERNAME/MQTT_PASSWORD values, because mqtt_link.js pastes them unescaped into mqtt://USER:PASS@HOST:PORT; null means the field is absent from the packet; expected_connect_error.after_ms is how long the failure takes (fake clock). expected_dialed is the host and port the bridge dials instead of the configured broker when the URL breaks (the username survives as the host name). Identical on Node 10.14 and Node 24. 'connack_refusals': a CONNACK with a non-zero return code makes the connection attempt fail with this error. 'commands': MQTT messages received by the bridge (delivered whether or not it subscribed to the topic) and the panel requests they cause; expected_panel_requests is an unordered list of request lines. 'broker_ports': what the bridge dials for a given MQTT_PORT string (the host is always MQTT_HOSTNAME); unparsable values silently become the MQTT default 1883. 'broker_hosts': what the bridge dials for a given MQTT_HOSTNAME/MQTT_PORT pair, because the host is pasted unescaped into the same URL.",
  "credentials": [
    {
      "name": "plain username and password",
      "username": "user",
      "password": "pass",
      "expected_broker_username": "user",
      "expected_broker_password": "pass"
    },
    {
      "name": "'@' in the password",
      "username": "user",
      "password": "pa@ss",
      "expected_broker_username": "user",
      "expected_broker_password": "pa@ss",
      "note": "the URL parser splits at the last '@', so this survives"
    },
    {
      "name": "'@' in the username",
      "username": "us@er",
      "password": "pass",
      "expected_broker_username": "us@er",
      "expected_broker_password": "pass"
    },
    {
      "name": "'@' in both",
      "username": "us@er",
      "password": "pa@ss",
      "expected_broker_username": "us@er",
      "expected_broker_password": "pa@ss"
    },
    {
      "name": "space in the password",
      "username": "user",
      "password": "pa ss",
      "expected_broker_username": "user",
      "expected_broker_password": "pa ss"
    },
    {
      "name": "plus, quote and punctuation",
      "username": "user",
      "password": "pa+s\"s!~*'()",
      "expected_broker_username": "user",
      "expected_broker_password": "pa+s\"s!~*'()"
    },
    {
      "name": "leading and trailing spaces in the password",
      "username": "user",
      "password": " pass ",
      "expected_broker_username": "user",
      "expected_broker_password": " pass "
    },
    {
      "name": "unicode letters and a currency sign",
      "username": "üser",
      "password": "pässwörd€",
      "expected_broker_username": "üser",
      "expected_broker_password": "pässwörd€"
    },
    {
      "name": "emoji in the password",
      "username": "user",
      "password": "p😀ss",
      "expected_broker_username": "user",
      "expected_broker_password": "p😀ss"
    },
    {
      "name": "':' in the username only",
      "username": "us:er",
      "password": "pass",
      "expected_broker_username": "us:er",
      "expected_broker_password": "pass",
      "note": "correct only by luck: the client splits user:pass at the LAST ':'"
    },
    {
      "name": "trailing ':' in the password",
      "username": "user",
      "password": "ab:",
      "expected_broker_username": "user",
      "expected_broker_password": "ab:",
      "note": "correct by the same luck: the last ':' that is followed by something is the separator"
    },
    {
      "name": "password that is a single ':'",
      "username": "user",
      "password": ":",
      "expected_broker_username": "user",
      "expected_broker_password": ":"
    },
    {
      "name": "':' inside the password",
      "username": "user",
      "password": "pa:ss",
      "expected_broker_username": "user:pa",
      "expected_broker_password": "ss",
      "known_bug": "KB-8"
    },
    {
      "name": "leading ':' in the password",
      "username": "user",
      "password": ":ab",
      "expected_broker_username": "user:",
      "expected_broker_password": "ab",
      "known_bug": "KB-8"
    },
    {
      "name": "several ':' in the password",
      "username": "user",
      "password": "a:b:c",
      "expected_broker_username": "user:a:b",
      "expected_broker_password": "c",
      "known_bug": "KB-8"
    },
    {
      "name": "':' in both username and password",
      "username": "us:er",
      "password": "pa:ss",
      "expected_broker_username": "us:er:pa",
      "expected_broker_password": "ss",
      "known_bug": "KB-8"
    },
    {
      "name": "empty password",
      "username": "user",
      "password": "",
      "expected_broker_username": "user:",
      "expected_broker_password": null,
      "known_bug": "KB-8",
      "note": "config.js accepts an empty value; the broker sees the trailing ':' as part of the username and no password at all"
    },
    {
      "name": "empty username",
      "username": "",
      "password": "pass",
      "expected_broker_username": ":pass",
      "expected_broker_password": null,
      "known_bug": "KB-8",
      "note": "the whole 'user:pass' pair is sent as the username"
    },
    {
      "name": "empty username and empty password",
      "username": "",
      "password": "",
      "expected_broker_username": ":",
      "expected_broker_password": null,
      "known_bug": "KB-8"
    },
    {
      "name": "percent-encoded '@' in the password is decoded",
      "username": "user",
      "password": "pa%40ss",
      "expected_broker_username": "user",
      "expected_broker_password": "pa@ss",
      "known_bug": "KB-8",
      "note": "a literal '%40' in the configured password can never be sent; users can work around the other problems only by pre-encoding"
    },
    {
      "name": "percent-encoded '/' in the password is decoded",
      "username": "user",
      "password": "pa%2Fss",
      "expected_broker_username": "user",
      "expected_broker_password": "pa/ss",
      "known_bug": "KB-8"
    },
    {
      "name": "percent-encoded '%' in the password is decoded",
      "username": "user",
      "password": "pa%25ss",
      "expected_broker_username": "user",
      "expected_broker_password": "pa%ss",
      "known_bug": "KB-8"
    },
    {
      "name": "percent-encoded '@' in the username is decoded",
      "username": "us%40er",
      "password": "pass",
      "expected_broker_username": "us@er",
      "expected_broker_password": "pass",
      "known_bug": "KB-8"
    },
    {
      "name": "'%' followed by non-hex in the password",
      "username": "user",
      "password": "pa%ss",
      "expected_connect_error": {
        "message": "URI malformed",
        "after_ms": 0
      },
      "known_bug": "KB-8",
      "note": "URIError thrown while parsing the URL: nothing is logged, no connection is attempted"
    },
    {
      "name": "'%' at the end of the password",
      "username": "user",
      "password": "100%",
      "expected_connect_error": {
        "message": "URI malformed",
        "after_ms": 0
      },
      "known_bug": "KB-8"
    },
    {
      "name": "'/' in the password",
      "username": "admin",
      "password": "pa/ss",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1883
      },
      "known_bug": "KB-8",
      "note": "the part of the pair before the first '/' ('#', '?', '\\\\') is taken as the host name (port 1883): the configured broker is never contacted"
    },
    {
      "name": "'#' in the password",
      "username": "admin",
      "password": "pa#ss",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1883
      },
      "known_bug": "KB-8"
    },
    {
      "name": "'?' in the password",
      "username": "admin",
      "password": "pa?ss",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1883
      },
      "known_bug": "KB-8"
    },
    {
      "name": "backslash in the password",
      "username": "admin",
      "password": "pa\\ss",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1883
      },
      "known_bug": "KB-8",
      "note": "the URL parser reads '\\' as '/'"
    },
    {
      "name": "'/' after digits in the password",
      "username": "admin",
      "password": "1884/x",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1884
      },
      "known_bug": "KB-8",
      "note": "the digits before the '/' are read as the port of the 'host': the bridge dials the username on a port taken from the password"
    },
    {
      "name": "'/' in the username",
      "username": "ad/min",
      "password": "pass",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "ad",
        "port": 1883
      },
      "known_bug": "KB-8"
    }
  ],
  "broker_ports": [
    {
      "name": "plain number",
      "mqtt_port": "2883",
      "expected_dialed_port": 2883
    },
    {
      "name": "leading zeros are accepted",
      "mqtt_port": "02883",
      "expected_dialed_port": 2883
    },
    {
      "name": "highest valid port",
      "mqtt_port": "65535",
      "expected_dialed_port": 65535
    },
    {
      "name": "empty value",
      "mqtt_port": "",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24",
      "note": "config.js accepts an empty MQTT_PORT"
    },
    {
      "name": "non-numeric value",
      "mqtt_port": "abc",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "zero",
      "mqtt_port": "0",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "number followed by text",
      "mqtt_port": "2883abc",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "number with a leading sign",
      "mqtt_port": "+2883",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "negative number",
      "mqtt_port": "-2883",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "decimal number",
      "mqtt_port": "2883.5",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "hexadecimal number",
      "mqtt_port": "0x10",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "exponent notation",
      "mqtt_port": "1e3",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "number with a leading space",
      "mqtt_port": " 2883",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "port above 65535",
      "mqtt_port": "99999",
      "expected_connect_error": {
        "message_prefix": "Port should be >= 0 and < 65536",
        "after_ms": 0
      },
      "note": "rejected immediately, nothing logged, no connection attempt"
    },
    {
      "name": "port 65536",
      "mqtt_port": "65536",
      "expected_connect_error": {
        "message_prefix": "Port should be >= 0 and < 65536",
        "after_ms": 0
      }
    }
  ],
  "broker_hosts": [
    {
      "name": "plain host name",
      "mqtt_hostname": "broker.local",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "broker.local",
        "port": 1883
      }
    },
    {
      "name": "IPv4 address",
      "mqtt_hostname": "192.168.1.5",
      "mqtt_port": "1884",
      "expected_dialed": {
        "host": "192.168.1.5",
        "port": 1884
      }
    },
    {
      "name": "upper case is folded to lower case",
      "mqtt_hostname": "BROKER.Local",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "broker.local",
        "port": 1883
      }
    },
    {
      "name": "IPv6 address in brackets",
      "mqtt_hostname": "[::1]",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "::1",
        "port": 1883
      },
      "note": "works only because the user typed the brackets"
    },
    {
      "name": "non-ASCII host name is converted to punycode",
      "mqtt_hostname": "bröker.local",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "xn--brker-kua.local",
        "port": 1883
      }
    },
    {
      "name": "IPv6 address without brackets",
      "mqtt_hostname": "::1",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": ":1883",
        "port": 1883
      },
      "known_bug": "KB-26",
      "note": "MQTT_PORT is glued onto the address, the result is read as a host name"
    },
    {
      "name": "empty host name",
      "mqtt_hostname": "",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": ":1883",
        "port": 1883
      },
      "known_bug": "KB-26",
      "note": "config.js accepts an empty value; the bridge dials the host ':1883'"
    },
    {
      "name": "port inside the host name is ignored",
      "mqtt_hostname": "broker.local:1884",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "broker.local",
        "port": 1883
      },
      "known_bug": "KB-26"
    },
    {
      "name": "path after the host name is dropped",
      "mqtt_hostname": "broker.local/mqtt",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "broker.local",
        "port": 1883
      },
      "known_bug": "KB-26"
    },
    {
      "name": "text after a space is dropped",
      "mqtt_hostname": "broker local",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "broker",
        "port": 1883
      },
      "known_bug": "KB-26"
    },
    {
      "name": "IPv6 address with a zone id",
      "mqtt_hostname": "fe80::1%eth0",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "fe80",
        "port": 1
      },
      "known_bug": "KB-26",
      "note": "the bridge dials host 'fe80' on port 1 and silently drops the rest"
    }
  ],
  "connack_refusals": [
    {
      "name": "return code 1 (unacceptable protocol version)",
      "return_code": 1,
      "expected_error_code": 1,
      "expected_error_message": "Connection refused: Unacceptable protocol version"
    },
    {
      "name": "return code 2 (identifier rejected)",
      "return_code": 2,
      "expected_error_code": 2,
      "expected_error_message": "Connection refused: Identifier rejected"
    },
    {
      "name": "return code 3 (server unavailable)",
      "return_code": 3,
      "expected_error_code": 3,
      "expected_error_message": "Connection refused: Server unavailable"
    },
    {
      "name": "return code 4 (bad username or password)",
      "return_code": 4,
      "expected_error_code": 4,
      "expected_error_message": "Connection refused: Bad username or password"
    },
    {
      "name": "return code 5 (not authorized)",
      "return_code": 5,
      "expected_error_code": 5,
      "expected_error_message": "Connection refused: Not authorized"
    },
    {
      "name": "reserved return code 6",
      "return_code": 6,
      "expected_error_code": 6,
      "expected_error_message": "Connection refused: undefined",
      "note": "the message text comes from the mqtt library, which has no entry for this code; only 'any non-zero code fails the connect' matters"
    }
  ],
  "commands": [
    {
      "name": "arm topic arms the panel",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r"
      ]
    },
    {
      "name": "disarm topic disarms the panel",
      "messages": [
        {
          "topic": "paradox/command/disarm",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=d"
      ]
    },
    {
      "name": "arm with an empty payload still arms",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": ""
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "arm with payload OFF still arms",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": "OFF"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "arm with a JSON payload still arms",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": "{\"armed\": false}"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "disarm with an empty payload still disarms",
      "messages": [
        {
          "topic": "paradox/command/disarm",
          "payload": ""
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=d"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "disarm with payload OFF still disarms",
      "messages": [
        {
          "topic": "paradox/command/disarm",
          "payload": "OFF"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=d"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "disarm with a non-ASCII payload still disarms",
      "messages": [
        {
          "topic": "paradox/command/disarm",
          "payload": "ÿþ"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=d"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "two arm messages arm twice (no de-duplication)",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": "ON"
        },
        {
          "topic": "paradox/command/arm",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r",
        "GET /statuslive.html?area=00&value=r"
      ]
    },
    {
      "name": "arm and disarm messages each send their own request",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": "ON"
        },
        {
          "topic": "paradox/command/disarm",
          "payload": "OFF"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r",
        "GET /statuslive.html?area=00&value=d"
      ]
    },
    {
      "name": "topic match is case sensitive",
      "messages": [
        {
          "topic": "paradox/command/ARM",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": []
    },
    {
      "name": "topic must match exactly: extra level",
      "messages": [
        {
          "topic": "paradox/command/arm/extra",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": []
    },
    {
      "name": "topic must match exactly: trailing slash",
      "messages": [
        {
          "topic": "paradox/command/disarm/",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": []
    },
    {
      "name": "topic must match exactly: other prefix",
      "messages": [
        {
          "topic": "other/paradox/command/arm",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": []
    },
    {
      "name": "unknown command topic is ignored",
      "messages": [
        {
          "topic": "paradox/command/panic",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": []
    },
    {
      "name": "the bridge's own status topic is ignored",
      "messages": [
        {
          "topic": "paradox/status/armed",
          "payload": "ON"
        }
      ],
      "expected_panel_requests": []
    }
  ]
}
