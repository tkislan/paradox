    }
  ],
  "retry": [
    {
      "name": "first attempt succeeds",
      "max_retries": 3,
      "wait_ms": 1000,
      "attempts": [{"returns": "ok"}],
      "expected": {"calls": 1, "returns": "ok"}
    },
    {
      "name": "returns what the function returned, falsy values included",
      "max_retries": 3,
      "wait_ms": 1000,
      "attempts": [{"returns": 0}],
      "expected": {"calls": 1, "returns": 0}
    },
    {
      "name": "null result is returned, not retried",
      "max_retries": 3,
      "wait_ms": 1000,
      "attempts": [{"returns": null}],
      "expected": {"calls": 1, "returns": null}
    },
    {
      "name": "one failure, then success",
      "max_retries": 3,
      "wait_ms": 1000,
      "attempts": [{"throws": "e1"}, {"returns": "ok"}],
      "expected": {"calls": 2, "returns": "ok"}
    },
    {
      "name": "succeeds on the last allowed attempt",
      "max_retries": 2,
      "wait_ms": 1000,
      "attempts": [{"throws": "e1"}, {"throws": "e2"}, {"returns": "ok"}],
      "expected": {"calls": 3, "returns": "ok"}
    },
    {
      "name": "one attempt too late: gives up after max_retries + 1 calls and rethrows the LAST error",
      "max_retries": 2,
      "wait_ms": 1000,
      "attempts": [{"throws": "e1"}, {"throws": "e2"}, {"throws": "e3"}, {"returns": "too late"}],
      "expected": {"calls": 3, "throws": "e3"}
    },
    {
      "name": "max_retries 0 means a single attempt",
      "max_retries": 0,
      "wait_ms": 1000,
      "attempts": [{"throws": "e1"}, {"returns": "ok"}],
      "expected": {"calls": 1, "throws": "e1"}
    },
    {
      "name": "max_retries 0 and success",
      "max_retries": 0,
      "wait_ms": 1000,
      "attempts": [{"returns": "ok"}],
      "expected": {"calls": 1, "returns": "ok"}
    },
    {
      "name": "negative max_retries behaves like 0",
      "max_retries": -1,
      "wait_ms": 1000,
      "attempts": [{"throws": "e1"}, {"returns": "ok"}],
      "expected": {"calls": 1, "throws": "e1"}
    },
    {
      "name": "max_retries 1: two calls, last error wins",
      "max_retries": 1,
      "wait_ms": 1000,
      "attempts": [{"throws": "e1"}, {"throws": "e2"}],
      "expected": {"calls": 2, "throws": "e2"}
    },
    {
      "name": "index page settings: 10 retries are 11 calls",
      "max_retries": 10,
      "wait_ms": 1000,
      "attempts": [
        {"throws": "e1"},
        {"throws": "e2"},
        {"throws": "e3"},
        {"throws": "e4"},
        {"throws": "e5"},
        {"throws": "e6"},
        {"throws": "e7"},
        {"throws": "e8"},
        {"throws": "e9"},
        {"throws": "e10"},
        {"throws": "e11"},
        {"returns": "too late"}
      ],
      "expected": {"calls": 11, "throws": "e11"}
    },
    {
      "name": "succeeds on the 11th call with 10 retries",
      "max_retries": 10,
      "wait_ms": 1000,
      "attempts": [
        {"throws": "e1"},
        {"throws": "e2"},
        {"throws": "e3"},
        {"throws": "e4"},
        {"throws": "e5"},
        {"throws": "e6"},
        {"throws": "e7"},
        {"throws": "e8"},
        {"throws": "e9"},
        {"throws": "e10"},
        {"returns": "ok"}
      ],
      "expected": {"calls": 11, "returns": "ok"}
    }
  ],
  "objectEntries": [
    {
      "name": "insertion order is kept",
      "object": {"b": 1, "a": 2},
      "expected": [["b", 1], ["a", 2]]
    },
    {
      "name": "empty object",
      "object": {},
      "expected": []
    },
    {
      "name": "values pass through unchanged",
      "object": {"list": [1, 2], "inner": {"k": null}},
      "expected": [["list", [1, 2]], ["inner", {"k": null}]]
    },
    {
      "name": "the signal table",
      "object": {"SIGHUP": 1, "SIGINT": 2, "SIGTERM": 15},
      "expected": [["SIGHUP", 1], ["SIGINT", 2], ["SIGTERM", 15]]
    }
  ],
  "signals": [
    {
      "signal": "SIGHUP",
      "number": 1,
      "exit_code": 129
    },
    {
      "signal": "SIGINT",
      "number": 2,
      "exit_code": 130
    },
    {
      "signal": "SIGTERM",
      "number": 15,
      "exit_code": 143
    }
  ]
}
