      "start": {"ready": false, "expect": {"panel_requests": ["GET /logout.html", "GET /login_page.html", "GET /default.html?u=EBA2095C&p=82016AC9BD9B087D6C393B19C756B255"], "process_exit": [1]}}
    },
    {
      "name": "a permanently failing index page is requested 11 times back to back, then exit code 1",
      "known_bug": "KB-5",
