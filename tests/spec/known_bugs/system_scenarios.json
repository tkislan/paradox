      "start": {"ready": false, "expect": {"panel_requests": ["GET /logout.html", "GET /login_page.html", "GET /default.html?u=EBA2095C&p=82016AC9BD9B087D6C393B19C756B255", "GET /index.html"], "broker_connects": 1, "rest_listening": false}},
      "steps": [
