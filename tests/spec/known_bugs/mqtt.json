{
  "_comment": "Rows of ../mqtt.json that pin a defect of the current code on purpose (known_bug: the catalog id in tests/README.md), moved here unchanged: the same groups and the same row format, which the comment of that file describes. A port does not have to reproduce any of them.",
  "credentials": [
    {
      "name": "':' inside the password",
      "username": "user",
      "password": "pa:ss",
      "expected_broker_username": "user:pa",
      "expected_broker_password": "ss",
      "known_bug": "KB-8"
    },
    {
      "name": "leading ':' in the password",
      "username": "user",
      "password": ":ab",
      "expected_broker_username": "user:",
      "expected_broker_password": "ab",
      "known_bug": "KB-8"
    },
    {
      "name": "several ':' in the password",
      "username": "user",
      "password": "a:b:c",
      "expected_broker_username": "user:a:b",
      "expected_broker_password": "c",
      "known_bug": "KB-8"
    },
    {
      "name": "':' in both username and password",
      "username": "us:er",
      "password": "pa:ss",
      "expected_broker_username": "us:er:pa",
      "expected_broker_password": "ss",
      "known_bug": "KB-8"
    },
    {
      "name": "empty password",
      "username": "user",
      "password": "",
      "expected_broker_username": "user:",
      "expected_broker_password": null,
      "expected_login": "refused",
      "known_bug": "KB-8",
      "note": "config.js accepts an empty value; the broker sees the trailing ':' as part of the username and no password at all, so it cannot authenticate any account"
    },
    {
      "name": "empty username",
      "username": "",
      "password": "pass",
      "expected_broker_username": ":pass",
      "expected_broker_password": null,
      "expected_login": "refused",
      "known_bug": "KB-8",
      "note": "the whole 'user:pass' pair is sent as the username, with no password, so a broker cannot authenticate any account"
    },
    {
      "name": "empty username and empty password",
      "username": "",
      "password": "",
      "expected_broker_username": ":",
      "expected_broker_password": null,
      "expected_login": "refused",
      "known_bug": "KB-8",
      "note": "the pair ':' is sent as the username, with no password, so a broker cannot authenticate any account"
    },
    {
      "name": "percent-encoded '@' in the password is decoded",
      "username": "user",
      "password": "pa%40ss",
      "expected_broker_username": "user",
      "expected_broker_password": "pa@ss",
      "known_bug": "KB-8",
      "note": "a literal '%40' in the configured password can never be sent; users can work around the other problems only by pre-encoding"
    },
    {
      "name": "percent-encoded '/' in the password is decoded",
      "username": "user",
      "password": "pa%2Fss",
      "expected_broker_username": "user",
      "expected_broker_password": "pa/ss",
      "known_bug": "KB-8"
    },
    {
      "name": "percent-encoded '%' in the password is decoded",
      "username": "user",
      "password": "pa%25ss",
      "expected_broker_username": "user",
      "expected_broker_password": "pa%ss",
      "known_bug": "KB-8"
    },
    {
      "name": "percent-encoded '@' in the username is decoded",
      "username": "us%40er",
      "password": "pass",
      "expected_broker_username": "us@er",
      "expected_broker_password": "pass",
      "known_bug": "KB-8"
    },
    {
      "name": "'%' followed by non-hex in the password",
      "username": "user",
      "password": "pa%ss",
      "expected_connect_error": {
        "message": "URI malformed",
        "after_ms": 0
      },
      "known_bug": "KB-8",
      "note": "URIError thrown while parsing the URL: nothing is logged, no connection is attempted"
    },
    {
      "name": "'%' at the end of the password",
      "username": "user",
      "password": "100%",
      "expected_connect_error": {
        "message": "URI malformed",
        "after_ms": 0
      },
      "known_bug": "KB-8"
    },
    {
      "name": "'/' in the password",
      "username": "admin",
      "password": "pa/ss",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1883
      },
      "known_bug": "KB-8",
      "note": "the part of the pair before the first '/' ('#', '?', '\\\\') is taken as the host name (port 1883): the configured broker is never contacted"
    },
    {
      "name": "'#' in the password",
      "username": "admin",
      "password": "pa#ss",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1883
      },
      "known_bug": "KB-8"
    },
    {
      "name": "'?' in the password",
      "username": "admin",
      "password": "pa?ss",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1883
      },
      "known_bug": "KB-8"
    },
    {
      "name": "backslash in the password",
      "username": "admin",
      "password": "pa\\ss",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1883
      },
      "known_bug": "KB-8",
      "note": "the URL parser reads '\\' as '/'"
    },
    {
      "name": "'/' after digits in the password",
      "username": "admin",
      "password": "1884/x",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "admin",
        "port": 1884
      },
      "known_bug": "KB-8",
      "note": "the digits before the '/' are read as the port of the 'host': the bridge dials the username on a port taken from the password"
    },
    {
      "name": "'/' in the username",
      "username": "ad/min",
      "password": "pass",
      "expected_connect_error": {
        "message": "MQTT connect timeout",
        "after_ms": 5000
      },
      "expected_dialed": {
        "host": "ad",
        "port": 1883
      },
      "known_bug": "KB-8"
    }
  ],
  "broker_ports": [
    {
      "name": "empty value",
      "mqtt_port": "",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24",
      "note": "config.js accepts an empty MQTT_PORT"
    },
    {
      "name": "non-numeric value",
      "mqtt_port": "abc",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "zero",
      "mqtt_port": "0",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "number followed by text",
      "mqtt_port": "2883abc",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "number with a leading sign",
      "mqtt_port": "+2883",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "negative number",
      "mqtt_port": "-2883",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "decimal number",
      "mqtt_port": "2883.5",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "hexadecimal number",
      "mqtt_port": "0x10",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "exponent notation",
      "mqtt_port": "1e3",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    },
    {
      "name": "number with a leading space",
      "mqtt_port": " 2883",
      "expected_dialed_port": 1883,
      "known_bug": "KB-24"
    }
  ],
  "broker_hosts": [
    {
      "name": "IPv6 address without brackets",
      "mqtt_hostname": "::1",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": ":1883",
        "port": 1883
      },
      "known_bug": "KB-26",
      "note": "MQTT_PORT is glued onto the address, the result is read as a host name"
    },
    {
      "name": "empty host name",
      "mqtt_hostname": "",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": ":1883",
        "port": 1883
      },
      "known_bug": "KB-26",
      "note": "config.js accepts an empty value; the bridge dials the host ':1883'"
    },
    {
      "name": "port inside the host name is ignored",
      "mqtt_hostname": "broker.local:1884",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "broker.local",
        "port": 1883
      },
      "known_bug": "KB-26"
    },
    {
      "name": "path after the host name is dropped",
      "mqtt_hostname": "broker.local/mqtt",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "broker.local",
        "port": 1883
      },
      "known_bug": "KB-26"
    },
    {
      "name": "text after a space is dropped",
      "mqtt_hostname": "broker local",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "broker",
        "port": 1883
      },
      "known_bug": "KB-26"
    },
    {
      "name": "IPv6 address with a zone id",
      "mqtt_hostname": "fe80::1%eth0",
      "mqtt_port": "1883",
      "expected_dialed": {
        "host": "fe80",
        "port": 1
      },
      "known_bug": "KB-26",
      "note": "the bridge dials host 'fe80' on port 1 and silently drops the rest"
    }
  ],
  "commands": [
    {
      "name": "arm with an empty payload still arms",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": ""
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "arm with payload OFF still arms",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": "OFF"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "arm with a JSON payload still arms",
      "messages": [
        {
          "topic": "paradox/command/arm",
          "payload": "{\"armed\": false}"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=r"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "disarm with an empty payload still disarms",
      "messages": [
        {
          "topic": "paradox/command/disarm",
          "payload": ""
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=d"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "disarm with payload OFF still disarms",
      "messages": [
        {
          "topic": "paradox/command/disarm",
          "payload": "OFF"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=d"
      ],
      "known_bug": "KB-16"
    },
    {
      "name": "disarm with a non-ASCII payload still disarms",
      "messages": [
        {
          "topic": "paradox/command/disarm",
          "payload": "ÿþ"
        }
      ],
      "expected_panel_requests": [
        "GET /statuslive.html?area=00&value=d"
      ],
      "known_bug": "KB-16"
    }
  ]
}
