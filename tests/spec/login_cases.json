      "known_bug": "KB-10"
    },
    {
      "name": "an accented name on a disabled slot makes login fail as well",
      "panel": { "/index.html": { "zones": [[1, "Door"], [0, "Pivnica č. 2"]] } },
      "expected": { "error": "Regex didn't match the value" },
      "known_bug": "KB-10"
    },
    {
      "name": "a hyphen in a zone name makes login fail",
      "panel": { "/index.html": { "zones": [[1, "Pred-sien"]] } },
      "expected": { "error": "Regex didn't match the value" },
      "known_bug": "KB-10"
    },
    {
      "name": "an apostrophe in a zone name makes login fail",
      "panel": { "/index.html": { "zones": [[1, "Peter's room"]] } },
      "expected": { "error": "Regex didn't match the value" },
      "known_bug": "KB-10"
    },
    {
      "name": "a dot in a zone name makes login fail",
      "panel": { "/index.html": { "zones": [[1, "1.floor"]] } },
      "expected": { "error": "Regex didn't match the value" },
      "known_bug": "KB-10"
    },
    {
      "name": "a comma in a zone name makes login fail",
      "panel": { "/index.html": { "zones": [[1, "A,B"]] } },
      "expected": { "error": "Regex didn't match the value" },
      "known_bug": "KB-10"
    },
    {
      "name": "an empty name on an enabled zone makes login fail",
      "panel": { "/index.html": { "zones": [[1, ""]] } },
      "expected": { "error": "Regex didn't match the value" },
      "known_bug": "KB-10"
    },
    {
      "name": "an empty name on a disabled slot makes login fail as well",
      "panel": { "/index.html": { "zones": [[1, "Door"], [0, ""]] } },
      "expected": { "error": "Regex didn't match the value" },
      "known_bug": "KB-10"
    },

    {
      "name": "an index page without tbl_zone makes login fail",
      "panel": { "/index.html": { "body": "<html><head></head><body>nothing here</body></html>" } },
      "expected": { "error": "Regex didn't match the value" }
    },
    {
      "name": "the login page in place of the index page makes login fail without a retry",
