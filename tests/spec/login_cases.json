      "expected": { "error": "Regex didn't match the value" },
      "note": "Retries cover failed requests only; a 200 page that does not parse ends login at once (one /index.html request)."
    },
    {
      "name": "tbl_zone without spaces around the equals sign is not found",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone=new Array(1,\"A\");</script></html>" } },
      "expected": { "error": "Regex didn't match the value" }
    },
    {
      "name": "tbl_zone without a space before the equals sign is not found",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone= new Array(1,\"A\");</script></html>" } },
      "expected": { "error": "Regex didn't match the value" }
    },
    {
      "name": "tbl_zone without a space after the equals sign is not found",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone =new Array(1,\"A\");</script></html>" } },
      "expected": { "error": "Regex didn't match the value" }
    },
    {
      "name": "a space after a comma in the zone list is not accepted",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(1, \"A\");</script></html>" } },
      "expected": { "error": "Regex didn't match the value" }
    },
    {
      "name": "a zone list without its closing parenthesis makes login fail",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(1,\"A\"" } },
      "expected": { "error": "Regex didn't match the value" }
    },
    {
      "name": "several spaces around the equals sign are accepted",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone   =   new Array(1,\"A\");</script></html>" } },
      "expected": { "zoneTuples": [[1, "A"]] }
    },
    {
      "name": "a trailing comma in the zone list is accepted",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(1,\"A\",);</script></html>" } },
      "expected": { "zoneTuples": [[1, "A"]] }
    },
    {
      "name": "the first tbl_zone assignment of the page is used",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(1,\"First\");\ntbl_zone = new Array(1,\"Second\");</script></html>" } },
      "expected": { "zoneTuples": [[1, "First"]] }
    },
    {
      "name": "an enabled flag of two digits makes login fail",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(10,\"A\");</script></html>" } },
      "expected": { "error": "Regex didn't match the value" },
      "known_bug": "KB-40",
      "note": "If the first number really is an area bitmask (tests/README.md), a zone of area 5 (flag 16) makes the whole login fail."
    },
    {
      "name": "a line break after the equals sign is not accepted",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone =\nnew Array(1,\"A\");</script></html>" } },
      "expected": { "error": "Regex didn't match the value" }
    },
    {
      "name": "the variable name is matched case-sensitively",
