        "default_query": "u=1A7AE573&p=879A30BC1CDD0EEA6FBB52215CF2C5D7"
      },
      "note": "u and p are the independent spec/crypto_reference.py result for username user and password 1234; the panel override accepts any credentials."
    },

    {
      "name": "a login page HTTP 500 rejects before any credentials are sent",
      "panel": { "/login_page.html": { "status": 500 } },
      "expected": { "error": "Request failed with status code 500", "request_counts": { "/logout.html": 1, "/login_page.html": 1 } }
    },
    {
      "name": "a login page HTTP 404 rejects",
      "panel": { "/login_page.html": { "status": 404 } },
      "expected": { "error": "Request failed with status code 404", "request_counts": { "/logout.html": 1, "/login_page.html": 1 } }
    },
    {
      "name": "a reset connection on the login page rejects",
      "panel": { "/login_page.html": { "destroy": true } },
      "expected": { "error": "socket hang up", "request_counts": { "/logout.html": 1, "/login_page.html": 1 } }
    },
    {
      "name": "a default.html HTTP 500 rejects and the index page is never requested",
      "panel": { "/default.html": { "status": 500 } },
      "expected": { "error": "Request failed with status code 500", "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1 } }
    },
    {
      "name": "a reset connection on default.html rejects",
      "panel": { "/default.html": { "destroy": true } },
      "expected": { "error": "socket hang up", "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1 } }
    },
    {
      "name": "a failing logout before login is only a warning",
      "panel": { "/logout.html": { "status": 500 } },
      "expected": {
        "zoneTuples": [[1, "Predsien"], [1, "Lava izba"], [1, "Prava izba"], [1, "Spalna"], [1, "Obyvacka"], [1, "Chodba"]],
        "warnings": ["Logout before login failed"]
      }
    },
    {
      "name": "a reset connection on the logout before login is only a warning",
      "panel": { "/logout.html": { "destroy": true } },
      "expected": {
        "zoneTuples": [[1, "Predsien"], [1, "Lava izba"], [1, "Prava izba"], [1, "Spalna"], [1, "Obyvacka"], [1, "Chodba"]],
        "warnings": ["Logout before login failed"]
      }
    },
    {
      "name": "when logout and login page both fail the login page error is reported",
      "panel": { "/logout.html": { "status": 500 }, "/login_page.html": { "status": 404 } },
      "expected": {
        "error": "Request failed with status code 404",
        "request_counts": { "/logout.html": 1, "/login_page.html": 1 },
        "warnings": ["Logout before login failed"]
      }
    },

    {
      "name": "a redirect of the default page is followed",
      "panel": {
        "/default.html": { "status": 302, "headers": { "Location": "/default_moved.html" } },
        "/default_moved.html": { "file": "data/default_page.html" }
      },
      "expected": {
        "zoneTuples": [[1, "Predsien"], [1, "Lava izba"], [1, "Prava izba"], [1, "Spalna"], [1, "Obyvacka"], [1, "Chodba"]],
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/default_moved.html": 1, "/index.html": 1 }
      }
    },
    {
      "name": "a redirect of the index page is followed and is not a retry",
      "panel": {
        "/index.html": { "status": 302, "headers": { "Location": "/index_moved.html" } },
        "/index_moved.html": { "zones": [[1, "Moved"]] }
      },
      "expected": {
        "zoneTuples": [[1, "Moved"]],
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/index.html": 1, "/index_moved.html": 1 }
      }
    }
  ],

  "index_retry": [
    {
      "name": "the index page is requested again right after one failure",
      "panel": { "/index.html": { "status": 500, "times": 1 } },
      "expected": {
        "zoneTuples": [[1, "Predsien"], [1, "Lava izba"], [1, "Prava izba"], [1, "Spalna"], [1, "Obyvacka"], [1, "Chodba"]],
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/index.html": 2 }
      },
      "known_bug": "KB-5",
      "note": "INDEX_PAGE_RETRY_WAIT_TIME (1000 ms) is never used. The test never advances its fake clock, so any wait between attempts would hang it."
    },
    {
      "name": "three failures are retried back to back",
      "panel": { "/index.html": { "status": 404, "times": 3 } },
      "expected": {
        "zoneTuples": [[1, "Predsien"], [1, "Lava izba"], [1, "Prava izba"], [1, "Spalna"], [1, "Obyvacka"], [1, "Chodba"]],
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/index.html": 4 }
      },
      "known_bug": "KB-5"
    },
    {
      "name": "reset connections are retried like HTTP errors",
      "panel": { "/index.html": { "destroy": true, "times": 2 } },
      "expected": {
        "zoneTuples": [[1, "Predsien"], [1, "Lava izba"], [1, "Prava izba"], [1, "Spalna"], [1, "Obyvacka"], [1, "Chodba"]],
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/index.html": 3 }
      },
      "known_bug": "KB-5"
    },
    {
      "name": "ten failures still succeed on the eleventh attempt",
      "panel": { "/index.html": { "status": 500, "times": 10 } },
      "expected": {
        "zoneTuples": [[1, "Predsien"], [1, "Lava izba"], [1, "Prava izba"], [1, "Spalna"], [1, "Obyvacka"], [1, "Chodba"]],
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/index.html": 11 }
      },
      "known_bug": "KB-5"
    },
    {
      "name": "eleven failures reject after exactly eleven attempts",
      "panel": { "/index.html": { "status": 500 } },
      "expected": {
        "error": "Request failed with status code 500",
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/index.html": 11 }
      },
      "known_bug": "KB-5"
    },
    {
      "name": "eleven reset connections reject after exactly eleven attempts",
      "panel": { "/index.html": { "destroy": true } },
      "expected": {
        "error": "socket hang up",
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/index.html": 11 }
      },
      "known_bug": "KB-5"
    },
    {
      "name": "the error of the last attempt is the one reported",
      "panel": { "/index.html": [{ "destroy": true, "times": 10 }, { "status": 503 }] },
      "expected": {
        "error": "Request failed with status code 503",
        "request_counts": { "/logout.html": 1, "/login_page.html": 1, "/default.html": 1, "/index.html": 11 }
      },
      "known_bug": "KB-5"
    }
  ],

  "logout": [
    {
      "name": "logout() resolves when the panel answers 200",
      "panel": {},
      "expected": {}
    },
    {
      "name": "logout() rejects on an HTTP error",
      "panel": { "/logout.html": { "status": 500 } },
      "expected": { "error": "Request failed with status code 500" }
    },
    {
      "name": "logout() rejects on a 404",
      "panel": { "/logout.html": { "status": 404 } },
      "expected": { "error": "Request failed with status code 404" }
    },
    {
      "name": "logout() rejects when the connection is reset",
      "panel": { "/logout.html": { "destroy": true } },
      "expected": { "error": "socket hang up" }
    }
  ],

