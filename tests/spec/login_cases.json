    },
    {
      "name": "tbl_zone is found when declared with var and indented",
      "panel": { "/index.html": { "body": "<html><script>\n    var tbl_zone = new Array(1,\"A\");\n</script></html>" } },
      "expected": { "zoneTuples": [[1, "A"]] }
    },

    {
