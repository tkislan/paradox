{
  "_comment": "Scenarios for src/api/login.js: login() is run against a fake panel and must resolve to expected.zoneTuples or reject with expected.error (exact message). Unless a row says otherwise the panel behaves like mock_paradox.js with session value 91AC25D06A0C26BA, accepts the u/p of crypto.json 'sample session, 4 digit code' (username user, password 1234) and lists the six sample zones. 'panel' overrides the answer for one request path: a response or a list of responses used in order; each response is {file} (relative to tests/), {body}, {status[, headers][, body]} (200, no extra headers and an empty body when omitted), {zones} (the index page with these [enabled, name] slots, padded to 32 slots with [0, ' '] like the real panel), {zones_by_slot} (the same, sparse: slot index -> [enabled, name]), {destroy} (the connection is reset) or {hang} (never answered); 'times' limits how often a response is used (forever when omitted). 'expected.default_query' is the exact query string of the first /default.html request. 'expected.request_counts' is how often the panel was asked for each path (a path that is not listed was never asked; one request to each of /logout.html, /login_page.html, /default.html and /index.html when the whole object is omitted). 'expected.warnings' are the messages logged with console.warn (none when omitted). Error messages starting with 'Request failed' come from axios and 'socket hang up' / 'connect ECONNREFUSED' from Node's http client: a port only has to fail there. known_bug rows pin behaviour a port should probably not copy.",

  "login": [
    {
      "name": "captured login, default and index pages of a real panel give the six enabled zones",
      "panel": {
        "/login_page.html": { "file": "data/login_page.html" },
        "/default.html": { "file": "data/default_page.html" },
        "/index.html": { "file": "data/index_page.html" }
      },
      "expected": { "zoneTuples": [[1, "Predsien"], [1, "Lava izba"], [1, "Prava izba"], [1, "Spalna"], [1, "Obyvacka"], [1, "Chodba"]] }
    },

    {
      "name": "disabled slots are dropped and enabled names are kept exactly as given",
      "panel": { "/index.html": { "zones": [[1, "Door"], [0, "Hall"], [1, " Padded "], [1, " "], [0, "Cellar"]] } },
      "expected": { "zoneTuples": [[1, "Door"], [1, " Padded "], [1, " "]] }
    },
    {
      "name": "the result carries no slot numbers, so a disabled slot in front of an enabled one shifts its position",
      "panel": { "/index.html": { "zones": [[0, " "], [1, "Door"]] } },
      "expected": { "zoneTuples": [[1, "Door"]] },
      "known_bug": "KB-2",
      "note": "Door is slot 1 (0-based) on the panel but index 0 of the returned list; status_listener reads statuszone by that list position."
    },
    {
      "name": "flag values other than 1 are dropped",
      "panel": { "/index.html": { "zones": [[2, "Two"], [1, "One"], [9, "Nine"], [0, "Zero"]] } },
      "expected": { "zoneTuples": [[1, "One"]] }
    },
    {
      "name": "a zone assigned to both areas (flag 3) is dropped",
      "panel": { "/index.html": { "zones": [[3, "Both"], [1, "Area one"], [2, "Area two"]] } },
      "expected": { "zoneTuples": [[1, "Area one"]] },
      "known_bug": "KB-18",
      "note": "tests/README.md: the first number of a tbl_zone pair is an area bitmask, not an enabled flag, so 3 means areas 1 and 2. The bridge keeps only pairs equal to 1."
    },
    {
      "name": "no enabled zone gives an empty list",
      "panel": { "/index.html": { "zones": [] } },
      "expected": { "zoneTuples": [] }
    },
    {
      "name": "an empty tbl_zone array gives an empty list",
      "panel": { "/index.html": { "body": "<html><head></head><script>tbl_zone = new Array();</script></html>" } },
      "expected": { "zoneTuples": [] }
    },

    {
      "name": "a list of one zone is read completely",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(1,\"A\");</script></html>" } },
      "expected": { "zoneTuples": [[1, "A"]] }
    },
    {
      "name": "a list of two zones yields only the first",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(1,\"A\",1,\"B\");</script></html>" } },
      "expected": { "zoneTuples": [[1, "A"]] },
      "known_bug": "KB-1"
    },
    {
      "name": "a list of three zones yields only the first two",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(1,\"A\",1,\"B\",1,\"C\");</script></html>" } },
      "expected": { "zoneTuples": [[1, "A"], [1, "B"]] },
      "known_bug": "KB-1"
    },
    {
      "name": "a list of four zones yields only the first two",
      "panel": { "/index.html": { "body": "<html><script>tbl_zone = new Array(1,\"A\",1,\"B\",1,\"C\",1,\"D\");</script></html>" } },
      "expected": { "zoneTuples": [[1, "A"], [1, "B"]] },
      "known_bug": "KB-1"
    },
    {
      "name": "32 enabled zones yield only the first 16",
      "panel": {
        "/index.html": {
          "zones": [
            [1, "z01"], [1, "z02"], [1, "z03"], [1, "z04"], [1, "z05"], [1, "z06"], [1, "z07"], [1, "z08"],
            [1, "z09"], [1, "z10"], [1, "z11"], [1, "z12"], [1, "z13"], [1, "z14"], [1, "z15"], [1, "z16"],
            [1, "z17"], [1, "z18"], [1, "z19"], [1, "z20"], [1, "z21"], [1, "z22"], [1, "z23"], [1, "z24"],
            [1, "z25"], [1, "z26"], [1, "z27"], [1, "z28"], [1, "z29"], [1, "z30"], [1, "z31"], [1, "z32"]
          ]
        }
      },
      "expected": {
        "zoneTuples": [
          [1, "z01"], [1, "z02"], [1, "z03"], [1, "z04"], [1, "z05"], [1, "z06"], [1, "z07"], [1, "z08"],
          [1, "z09"], [1, "z10"], [1, "z11"], [1, "z12"], [1, "z13"], [1, "z14"], [1, "z15"], [1, "z16"]
        ]
      },
      "known_bug": "KB-1"
    },
    {
      "name": "an enabled zone in slot 15 (the 16th) is still seen",
      "panel": { "/index.html": { "zones_by_slot": { "15": [1, "Sixteenth"] } } },
      "expected": { "zoneTuples": [[1, "Sixteenth"]] },
      "known_bug": "KB-1",
      "note": "Boundary of the bug: slots 0-15 are read."
    },
    {
      "name": "an enabled zone in slot 16 (the 17th) is silently dropped",
      "panel": { "/index.html": { "zones_by_slot": { "14": [1, "Fifteenth"], "16": [1, "Seventeenth"] } } },
      "expected": { "zoneTuples": [[1, "Fifteenth"]] },
      "known_bug": "KB-1"
    },

    {
      "name": "zone names of letters, digits, underscore and spaces are accepted",
      "panel": { "/index.html": { "zones": [[1, "Door_1"], [1, "Room 2"], [1, "UPPER lower 09"]] } },
      "expected": { "zoneTuples": [[1, "Door_1"], [1, "Room 2"], [1, "UPPER lower 09"]] }
    },
    {
      "name": "an accented zone name makes login fail",
      "panel": { "/index.html": { "zones": [[1, "Obývačka"]] } },
