  "transitions": [
    {
      "name": "identical polls emit once",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [
        { "statuszone": [1, 0], "useraccess": [2, 0] },
        { "statuszone": [1, 0], "useraccess": [2, 0] },
