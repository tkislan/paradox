  "failures": [
    {
      "name": "a failing first poll emits one error and nothing else",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [{ "fail": { "status": 500 } }],
      "expected_events": [["error"]]
    },
    {
      "name": "HTTP 404 is an error as well",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [{ "fail": { "status": 404 } }],
      "expected_events": [["error"]]
    },
    {
      "name": "the poll after a failed first poll is compared with the initial state",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [{ "fail": { "status": 500 } }, { "statuszone": [1, 0], "useraccess": [1, 0] }],
      "expected_events": [["error"], ["armedChanged", false], ["sensorChanged", "0", true]]
    },
    {
      "name": "a failed poll leaves the last good state untouched: the next identical poll emits nothing",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [
        { "statuszone": [1, 0], "useraccess": [1, 0] },
        { "fail": { "status": 500 } },
        { "statuszone": [1, 0], "useraccess": [1, 0] }
      ],
      "expected_events": [["armedChanged", false], ["sensorChanged", "0", true], ["error"]]
    },
    {
      "name": "changes that happened during the outage are emitted by the first good poll after it",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [
        { "statuszone": [1, 0], "useraccess": [1, 0] },
        { "fail": { "status": 500 } },
        { "statuszone": [0, 1], "useraccess": [2, 0] }
      ],
      "expected_events": [
        ["armedChanged", false],
        ["sensorChanged", "0", true],
        ["error"],
        ["armedChanged", true],
        ["sensorChanged", "0", false],
        ["sensorChanged", "1", true]
      ]
    },
    {
      "name": "three failed polls in a row: one error each",
      "zones": [[1, "A"]],
      "polls": [{ "fail": { "status": 500 } }, { "fail": { "status": 500 } }, { "fail": { "status": 500 } }],
      "expected_events": [["error"], ["error"], ["error"]]
    },
    {
      "name": "connection refused is an error, and the listener recovers when the panel is back",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [
        { "statuszone": [1, 0], "useraccess": [1, 0] },
        { "fail": { "connection": "refused" } },
        { "statuszone": [1, 0], "useraccess": [1, 0] }
      ],
      "expected_events": [["armedChanged", false], ["sensorChanged", "0", true], ["error"]]
    },
    {
      "name": "connection reset is an error, and the listener recovers",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [
        { "statuszone": [1, 0], "useraccess": [1, 0] },
        { "fail": { "connection": "reset" } },
        { "statuszone": [0, 0], "useraccess": [1, 0] }
      ],
      "expected_events": [["armedChanged", false], ["sensorChanged", "0", true], ["error"], ["sensorChanged", "0", false]]
    },
    {
      "name": "a page without status tables is an error",
      "zones": [[1, "A"], [1, "B"]],
      "polls": [{ "fail": { "page": { "file": "data/index_page.html" } } }],
      "expected_events": [["error"]]
    },
    {
      "name": "an error between two identical armed polls does not re-announce the armed state",
      "zones": [[1, "A"]],
      "polls": [
        { "statuszone": [0, 0], "useraccess": [2, 0] },
        { "fail": { "status": 500 } },
        { "statuszone": [0, 0], "useraccess": [2, 0] },
        { "fail": { "connection": "reset" } },
        { "statuszone": [0, 0], "useraccess": [2, 0] }
      ],
      "expected_events": [["armedChanged", true], ["error"], ["error"]]
    }
  ],
