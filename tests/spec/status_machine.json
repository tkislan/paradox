      ],
      "expected_events": [["armedChanged", true], ["sensorChanged", "0", true]]
    },
    {
      "name": "a sensor opens, closes and opens again: every change is emitted",
      "zones": [[1, "A"]],
      "polls": [
        { "statuszone": [1, 0], "useraccess": [0, 0] },
        { "statuszone": [0, 0], "useraccess": [0, 0] },
        { "statuszone": [1, 0], "useraccess": [0, 0] }
      ],
