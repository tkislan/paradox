        ["armedChanged", false],
        ["sensorChanged", "0", true],
        ["armedChanged", true],
        ["sensorChanged", "1", true],
        ["sensorChanged", "0", false],
        ["armedChanged", false],
        ["sensorChanged", "1", false]
      ]
    }
