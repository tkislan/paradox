{
  // Type-checks src/ (plain JavaScript, through its JSDoc types) and the TypeScript tests; nothing is compiled.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // Unannotated parameters stay allowed, as they were under Flow.
    "noImplicitAny": false,
    "module": "nodenext",
    "types": ["node"],
    // The tests import each other by their real (.ts) file names.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests"],
  "exclude": ["tests/coverage"]
}
